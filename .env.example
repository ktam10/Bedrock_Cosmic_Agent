# NASA provides DEMO_KEY for low-volume testing. Set a personal key for normal use.
NASA_API_KEY=DEMO_KEY

# The agent uses Groq's OpenAI-compatible endpoint. Either variable is accepted.
GROQ_API_KEY=replace_me
# OPENAI_API_KEY=replace_me

# Optional Datadog LLM Observability configuration.
# DD_API_KEY=replace_me
# DD_SITE=datadoghq.com
